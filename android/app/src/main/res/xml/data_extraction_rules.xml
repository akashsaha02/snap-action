<?xml version="1.0" encoding="utf-8"?>
<!-- Screenshots and the database can contain sensitive personal data, so
     nothing is included in cloud backups or device-to-device transfers. Users
     create explicit backups from Settings instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
