<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash (light): Acid Lime background with the
         adaptive foreground (glyph sits inside the 160dp icon mask). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/brand_acid_lime</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
